# Temporary & Backups
tmp_*.json
doc/*.bak
*.bak
# タイムスタンプ付きバックアップ（universe.db.bak_YYYYMMDD_HHMMSS 等）は *.bak に一致しない
*.bak_*
data/*.csv

# Backtest Cache (Parquet)
backend/backtest/cache/

# Production data & sandboxes -- never in git (doc/agent_execution_rules.md §10)
# ワークツリー内 sandbox の誤コミット防止（git add -A 事故対策の多層防御）
data/parquet_master*/
data/_bk/
*.db-shm
*.db-wal

# 秘匿値（SEC への連絡先メールアドレス等）。config.toml は git 管理下のため分離する
config.local.toml

# 実行時に生成する統合 CA バンドル（certifi + Windows 証明書ストア）
data/_ca_bundle_generated.pem

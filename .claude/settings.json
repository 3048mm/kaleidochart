{
  "permissions": {
    "allow": [
      "Bash(./venv/Scripts/python.exe -m pytest *)",
      "PowerShell(.\\venv\\Scripts\\python.exe -m pytest *)",
      "Bash(export PYTHONPATH=backend)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"$CLAUDE_PROJECT_DIR/tools/hooks/git_guard.ps1\"",
            "if": "Bash(git *)",
            "timeout": 15,
            "statusMessage": "git guard"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"$CLAUDE_PROJECT_DIR/tools/hooks/git_guard.ps1\"",
            "timeout": 15,
            "statusMessage": "git guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"$CLAUDE_PROJECT_DIR/tools/hooks/worktree_data_check.ps1\"",
            "timeout": 15,
            "statusMessage": "worktree data check"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
